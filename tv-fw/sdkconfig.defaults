CONFIG_IDF_TARGET="esp32p4"
# Chip v1.0 (WT9932P4-TINY): obligatorio el modo "revisiones < 3.0" y 360 MHz
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# misma tabla que Cerebro P4: BIOMA puede vivir en el otro espacio OTA y volver a Cerebro con un clic
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 32 MB de PSRAM en el encapsulado
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_128KB=y   # mÃ¡xima RAM interna: ahÃ­ vive el mapa de rastro (253 KB)

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# medir CPU por nÃºcleo
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# la simulaciÃ³n deja los dos nÃºcleos al 100%: el perro guardiÃ¡n no debe exigir que corra IDLE
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# USB: red NCM (la UVC se activa en CMakeLists.txt)
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=3
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=8192
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=8192

# lwIP
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_PRIO=18

# HTTP
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# nÃºcleo LP: reloj del dÃ­a con el temporizador RTC
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=12288

# ---- Wi-Fi por el ESP32-C3 montado encima (ESP-Hosted por UART, ver main/wifi.c) ----
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C3=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_UART_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_UART_PORT=1
CONFIG_ESP_HOSTED_UART_PIN_TX=28
CONFIG_ESP_HOSTED_UART_PIN_RX=29
CONFIG_ESP_HOSTED_UART_BAUDRATE=3000000
CONFIG_ESP_HOSTED_UART_GPIO_RESET_SLAVE=31
CONFIG_ESP_HOSTED_UART_RESET_ACTIVE_HIGH=y
# si el C3 no estÃ¡ o falla, el P4 NO se reinicia solo (con BIOMA y la tele corriendo, un reinicio en bucle serÃ­a peor)
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
# RAM interna: BIOMA ocupa 253 KB con el rastro y el Wi-Fi remoto dejaba 31 KB libres (el P4 se caÃ­a al conectar).
# Lo que no necesita RAM interna se va a la PSRAM (32 MB): mallocs de 2 KB o mÃ¡s, lwIP/Wi-Fi y las pilas de ESP-Hosted.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
# colas del enlace mÃ¡s largas: el video por Wi-Fi manda rÃ¡fagas de ~12 KB
CONFIG_ESP_HOSTED_UART_TX_Q_SIZE=16
CONFIG_ESP_HOSTED_UART_RX_Q_SIZE=16

# TIERRA VIVA: HTTPS con los búferes de TLS en PSRAM (la RAM interna la ocupa el rastro de BIOMA)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
